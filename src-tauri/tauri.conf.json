{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FroozERP",
  "version": "1.0.0",
  "identifier": "com.srtcompany.froozerp",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FroozERP",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dhirajmanwani/FroozERP/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDRTk0OTIzNkE4ODc4NUMKUldSY2VJaHFJMG5wL01jN0UrMTE5WDc4c0RZU29LTFRhSWhRdC91Q2NDbU92aW0wWSsvS2NsWmcK"
    }
  }
}
