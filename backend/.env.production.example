# FroozERP hosted backend production template.
# Copy values into the hosting provider secret manager. Do not commit real values.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080
APP_VERSION=1.0.30
APP_MODE=CLOUD_PRODUCTION
FROOZERP_DEPLOYMENT_TYPE=cloud

# Public HTTPS API URL. No localhost, loopback, LAN IP, .local host, or :5000.
CLOUD_API_URL=https://api.example.com

# Prefer a Railway Add Reference Variable, not a raw unresolved template string.
# DATABASE_URL must resolve to a postgresql:// or postgres:// URL before startup.
DATABASE_URL=postgresql://user:password@host:5432/database
CLOUD_DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# DB_* is local-development fallback only. Railway production refuses it.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

COMPANY_ID=
BRANCH_ID=
DEVICE_ID=
DEVICE_NAME=
FROOZERP_COMPANY_NAME=
FROOZERP_CLOUD_DEPLOYMENT_ID=

# Exact comma-separated HTTPS dashboard origins. Never use * in production.
ALLOWED_ORIGINS=https://owner.example.com
CORS_ORIGINS=

# Hosted production verifies an explicitly restored/migrated schema read-only.
RUN_STARTUP_SCHEMA_BOOTSTRAP=false
RUN_STARTUP_REFERENCE_SEED=false

# Use provider-managed PostgreSQL backups. This path is only for deliberate app backups.
BACKUP_DIR=/app/backups
