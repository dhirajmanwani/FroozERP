# FroozERP hosted backend production template.
# Copy values into the hosting provider secret manager. Do not commit real values.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080
APP_VERSION=1.0.30
APP_MODE=CLOUD_PRODUCTION
FROOZERP_DEPLOYMENT_TYPE=cloud
FROOZERP_RUNTIME_MODE=cloud-server
# The server refuses to start when these disagree (backend/hostedDeploymentGuard.js): cloud-server
# without APP_MODE=CLOUD_PRODUCTION, or a hosting platform with no cloud-server runtime.

# Public HTTPS API URL. No localhost, loopback, LAN IP, .local host, or :5000.
CLOUD_API_URL=https://api.example.com

# The ONLY variable the server connects with. Use the provider's reference/secret mechanism, not a
# raw unresolved template string. It must resolve to a postgresql:// or postgres:// URL before
# startup. For Neon use the DIRECT (non-pooler) endpoint with sslmode=verify-full in the URL; the
# URL's sslmode wins over DB_SSL below. CLOUD_DATABASE_URL is not read by the server.
DATABASE_URL=postgresql://user:password@host:5432/database
CLOUD_DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Pool size (1-100, default 10). Small managed databases want fewer; render.yaml sets 5 for Neon free.
PG_POOL_MAX=

# DB_* is NOT used to connect. DB_HOST/DB_NAME/DB_USER only feed a readiness check and a backup label.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

COMPANY_ID=
BRANCH_ID=
DEVICE_ID=
DEVICE_NAME=
FROOZERP_COMPANY_NAME=
FROOZERP_CLOUD_DEPLOYMENT_ID=

# Exact comma-separated HTTPS dashboard origins. Never use * in production.
ALLOWED_ORIGINS=https://owner.example.com
CORS_ORIGINS=

# Hosted production verifies an explicitly restored/migrated schema read-only.
RUN_STARTUP_SCHEMA_BOOTSTRAP=false
RUN_STARTUP_REFERENCE_SEED=false

# Use provider-managed PostgreSQL backups and scripts/cloud/backup-cloud.mjs. Set BACKUP_DIR ONLY to
# a mounted persistent volume: setting it is what tells the server its in-process backups survive.
# Unset on a host with an ephemeral disk, scheduled/shutdown backups are skipped and the manual
# backup route refuses with BACKUP_LOCATION_NOT_DURABLE.
BACKUP_DIR=

# Recovery codes by email (forgot password). Many hosts block outbound SMTP, so use an HTTPS
# email service there: EMAIL_PROVIDER is brevo or resend. Leave SMTP_* empty when these are set.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Only on hosts that allow outbound SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Proxy hops in front of the app (1-10, default 1). Only change it after checking req.ip on the host.
FROOZERP_TRUST_PROXY_HOPS=
# Cut-over freeze. true = every route except GET /api/health, /health, /api/time, /api/version
# answers 503 CLOUD_UNAVAILABLE and health reports status "frozen". Leave empty in normal running.
FROOZERP_CLOUD_FROZEN=
