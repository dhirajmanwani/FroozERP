# FroozERP backend runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APP_VERSION=1.0.30
APP_MODE=LOCAL_SINGLE_DEVICE

# Stable deployment/device identity. Keep blank until assigned deliberately.
COMPANY_ID=
BRANCH_ID=1
DEVICE_ID=
DEVICE_NAME=

# PostgreSQL. Use provider-managed production values for cloud deployment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=froozerp
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=
CLOUD_DATABASE_URL=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated browser/app origins. Required for cloud readiness.
CORS_ORIGINS=

# Cloud identity contract. Keep local defaults until a real hosted deployment exists.
CLOUD_API_URL=
FROOZERP_DEPLOYMENT_TYPE=local
# Compatibility aliases retained for existing deployments.
FROOZERP_COMPANY_ID=
FROOZERP_COMPANY_NAME=
FROOZERP_CLOUD_DEPLOYMENT_ID=
FROOZERP_PUBLIC_API_URL=
