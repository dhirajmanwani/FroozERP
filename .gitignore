# Real credentials. A-6 Gate 2.2, added 2026-08-22 after a scan found that nothing here
# covered them: DATABASE_URL, DEVICE_SESSION_SECRET, the WhatsApp access token and the
# SMTP password all live in a .env that the deployment docs tell you to create. Nothing
# has ever been committed - the whole history was scanned - but the only thing preventing
# it was that the file did not exist yet, and one `git add -A` would have been enough.
# Once pushed, a credential is leaked permanently; deleting it later does not unpublish it.
.env
.env.*
*.env
# The templates are the point of the templates.
!.env.example
!.env.*.example

backups/
node_modules/
frontend/node_modules/
frontend/dist/
src-tauri/target/
release/
*.sqlite
*.sqlite3
*.db
*.log
*.tmp
tmp-phase4b2-*.png

node_modules/
*/node_modules/
.cache/
*/.cache/
backend/node_modules/
frontend/node_modules/

# Preserved failure evidence and local build/runtime artifacts.
# Untracked already; listed here so git status stays readable.
_recovery_backups/
_up_/
binaries/
release-candidates/
scratchpad/
froozerp.exe
uninstall.exe

# Tauri generates a per-platform ACL schema. Windows is the only shipped target, so the
# desktop/windows schemas are tracked and the Linux one is a build byproduct of working on
# this repo from a Linux or cloud session. Ignored so it stays out of commits and out of
# git status.
src-tauri/gen/schemas/linux-schema.json
