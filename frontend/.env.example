# FroozERP frontend API selection
#
# Supported modes:
# - LOCAL_SINGLE_DEVICE: app and backend on the same laptop, http://127.0.0.1:5000
# - BRANCH_LAN_SERVER: branch server PC/laptop runs backend for same-shop LAN devices
# - BRANCH_LAN_CLIENT: cashier/purchase/back office device connects to branch server IP
# - CLOUD_PRODUCTION: hosted FroozERP cloud backend
# - FIELD_REMOTE_DEVICE: remote purchase tablet/laptop; requires cloud + future purchase sync
# - CUSTOM_API_URL: manually supplied backend URL
VITE_API_MODE=LOCAL_SINGLE_DEVICE

# Local single-device backend.
VITE_LOCAL_API_URL=http://127.0.0.1:5000

# Branch LAN backend. Use the branch server computer IP for LAN clients.
VITE_BRANCH_LAN_API_URL=http://192.168.1.41:5000

# Cloud backend. Keep blank until production cloud API is provisioned.
VITE_CLOUD_API_URL=

# Owner/admin override for a non-standard backend URL.
VITE_CUSTOM_API_URL=

# Branch server guidance for backend host/port. Backend runtime still uses HOST and PORT.
VITE_BRANCH_SERVER_BIND_HOST=0.0.0.0
VITE_BRANCH_SERVER_PORT=5000

# Optional deployment identity hints. Authoritative device identity remains in local SQLite
# and authoritative company/branch/user identity comes from the FroozERP backend.
VITE_COMPANY_ID=
VITE_BRANCH_ID=1
VITE_SUB_BRANCH_ID=
VITE_DEVICE_ID=
VITE_DEVICE_NAME=

# Backward compatibility. If set, this overrides the mode-specific URL.
# VITE_API_URL=http://127.0.0.1:5000
